#!/usr/bin/env bash
# Bootstrap: stands the environment up in one non-interactive command and ends in verify.
# Fill in both steps for this repository's stack; never prompt for input.
set -euo pipefail
cd "$(dirname "$0")/.."

install_deps() {
  echo "scripts/setup: nothing to install (scratch repository)"
}

run_verify() {
  test -f AGENTS.md && echo "scripts/setup: verify ok"
}

install_deps
run_verify
